{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "artwork_url": {
      "type": "string"
    },
    "is_free": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "on_sale",
        "sold_out",
        "cancelled",
        "completed"
      ],
      "default": "draft"
    },
    "total_tickets": {
      "type": "number",
      "default": 100
    },
    "tickets_sold": {
      "type": "number",
      "default": 0
    },
    "general_price": {
      "type": "number",
      "default": 0
    },
    "vip_price": {
      "type": "number",
      "default": 0
    },
    "early_bird_price": {
      "type": "number",
      "default": 0
    },
    "early_bird_available": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "NGN"
    },
    "revenue": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "artist"
  ]
}