PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

BASE_STORAGE_BUCKET=uploads

# --- Supabase project settings (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
# LLM (powers the AI Assistant / voice-sample tools)
ANTHROPIC_API_KEY=

# Outbound email (optional — SendEmail is a no-op log if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Audio transcription (optional — plug your ASR provider into routes/integrations.ts)
TRANSCRIPTION_PROVIDER_API_KEY=
